# Copy to .env and fill in. .env is gitignored - never commit a real key.
#
#   cp .env.example .env
#   python -m parchi.models_cli --filter glm --pick
#   python eval/evaluate.py --provider openai --limit 25

# --- OpenAI-compatible endpoint (nano-gpt, OpenRouter, Together, local vLLM) ---
PARCHI_OPENAI_BASE_URL=https://nano-gpt.com/api/v1
PARCHI_OPENAI_API_KEY=sk-replace-me

# Optional. Left unset, the model is resolved against the endpoint's live
# /models catalogue, preferring the GLM family.
# PARCHI_MODEL=z-ai/glm-4.7-flash

# Hard ceiling on model calls per process. A runaway loop over the 1,000-row
# batch is the realistic way a subscription gets burned; this makes it stop.
PARCHI_MAX_CALLS=1200

# --- Anthropic (optional; takes priority over the OpenAI-compatible endpoint) ---
# ANTHROPIC_API_KEY=sk-ant-replace-me
