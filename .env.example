# Copy to .env and fill in. .env is gitignored - never commit a real key.
#
#   cp .env.example .env
#   python -m parchi.models_cli --filter glm --pick
#   python eval/evaluate.py --provider openai --limit 25

# --- OpenAI-compatible endpoint (ElectronHub, OpenRouter, Together, vLLM) ---
PARCHI_OPENAI_BASE_URL=https://api.electronhub.ai/v1
PARCHI_OPENAI_API_KEY=replace-me

# Optional, and worth setting. Left unset, the model is resolved against the
# endpoint's live /models catalogue, which is one extra request and measured
# 42s on ElectronHub; pinning a name skips it entirely.
#
# Every model on that endpoint is a reasoning model, and reasoning tokens are
# spent from max_tokens BEFORE any content, so a ceiling that used to be
# generous returns an empty message rather than a short one. The provider now
# asks for reasoning_effort=none and allows 900 tokens.
# PARCHI_MODEL=glm-5.3-flash:dev

# Hard ceiling on model calls per process. A runaway loop over the 1,000-row
# batch is the realistic way a subscription gets burned; this makes it stop.
# ElectronHub dev keys are rated at 100 requests per 5 hours, and every
# adjudication can spend two. Keep this under the plan, not over it.
PARCHI_MAX_CALLS=80

# Trusted payer Ed25519 public keys used by POST /api/authorizations.
# PARCHI_PAYER_KEYS_JSON={"usr_123":"64-character-public-key-hex"}

# Separate operator credential required to retrieve one-time STEP_UP approval
# tokens. Keep this out of agent-facing requests and browser storage.
# PARCHI_HUMAN_APPROVAL_SECRET=replace-with-a-long-random-secret

# Demo binds only to loopback by default. Set deliberately for container/LAN use.
# HOST=127.0.0.1

# Explicitly opt into lexical demo verdicts. Default auto mode requires human
# confirmation when no live model is configured.
# PARCHI_DEMO_PROVIDER=heuristic

# --- Anthropic (optional; takes priority over the OpenAI-compatible endpoint) ---
# ANTHROPIC_API_KEY=sk-ant-replace-me

# --- Razorpay test mode (optional; enables real order creation in the demo) ---
# RAZORPAY_KEY_ID=rzp_test_replace_me
# RAZORPAY_KEY_SECRET=replace_me
# Webhook secret from Dashboard > Settings > API Keys > Webhooks. Required for
# POST /api/razorpay/webhook; without it the endpoint returns 503 rather than
# accepting unverified events. Point the webhook at:
#   http(s)://<your-host>/api/razorpay/webhook
# and subscribe to payment.captured, payment.failed, refund.processed.
# RAZORPAY_WEBHOOK_SECRET=replace_me

# Operations console at /console. Unset means the console is OFF, not open.
# PARCHI_CONSOLE_TOKEN=choose-a-long-random-string

# Model for the AI attack adjudicator (the 10-minute account cooldown gate).
# Defaults to glm-5.3-flash:dev, which measured 6-18s against DeepSeek's
# 37-60s on the same prompt. The fallback second opinion is a different
# family on purpose; see parchi/ai_guard.py.
# PARCHI_GUARD_MODEL=glm-5.3-flash:dev

# The shop-side seed account, so a fresh clone has something to sign in as.
# Unset means the published throwaway pair in demo/server.py. Set these to use
# your own; a password in a tracked file is a published password.
# PARCHI_DEMO_USER_EMAIL=you@example.com
# PARCHI_DEMO_USER_PASSWORD=choose-something-you-do-not-reuse
